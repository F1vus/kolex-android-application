<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_main"
    app:startDestination="@id/searchFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="edu.at.kolex.fragment.TicketSearchFragment"
        android:label="Search Trains">

        <action
            android:id="@+id/action_searchFragment_to_routesFragment"
            app:destination="@id/routesFragment" />
    </fragment>

    <fragment
        android:id="@+id/routesFragment"
        android:name="edu.at.kolex.fragment.RoutesFragment"
        android:label="Available Routes">

        <argument
            android:name="departure"
            app:argType="string" />

        <argument
            android:name="arrival"
            app:argType="string" />

        <action
            android:id="@+id/action_routesFragment_to_ticketDetailsFragment"
            app:destination="@id/ticketDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/ticketDetailsFragment"
        android:name="edu.at.kolex.fragment.TicketDetailsFragment"
        android:label="Ticket Details">

        <action
            android:id="@+id/action_ticketDetailsFragment_to_paymentFragment"
            app:destination="@id/paymentFragment" />
    </fragment>

    <fragment
        android:id="@+id/paymentFragment"
        android:name="edu.at.kolex.fragment.PaymentFragment"
        android:label="Payment" />

</navigation>