<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_ticket_details"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ECEFF1">

    <!-- TOOLBAR -->

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#8BC34A"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:title="Szczegóły biletu"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/outline_arrow_back_24" />

    <!-- CONTENT -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- KARTA BILETU -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="6dp">

            <TextView
                android:id="@+id/tvTrain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IC 1620"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvFrom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Warszawa Centralna"
                android:textSize="16sp"
                android:textColor="#424242" />

            <TextView
                android:id="@+id/tvTo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kraków Główny"
                android:textSize="16sp"
                android:textColor="#424242"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12.06.2026"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginBottom="16dp"/>

            <!-- SZCZEGÓŁY -->

            <TextView
                android:id="@+id/tvWagon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wagon: 5"
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvSeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Miejsce: 12A"
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvClass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Klasa: 2"
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvLuggage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bagaż: 1x do 20kg"
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginBottom="16dp"/>

            <!-- CENA -->

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="49.00 PLN"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- PRZYCISK -->

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Dalej"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#8BC34A"
            android:padding="14dp"/>

    </LinearLayout>

</LinearLayout>